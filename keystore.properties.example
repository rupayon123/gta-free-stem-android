# Example only. Never commit the real keystore.properties file or any key.
# Copy this file to keystore.properties only on the secured release machine,
# keep it chmod 600, and replace every placeholder locally.
# On macOS, scripts/build-signed-release-from-keychain.sh is the preferred
# alternative and avoids writing either password to this file.

storeFile=/ABSOLUTE/PATH/OUTSIDE/REPOSITORY/gta-free-stem-upload.jks
storePassword=REPLACE_WITH_PASSWORD_MANAGER_VALUE
keyAlias=gta-free-stem-upload
keyPassword=REPLACE_WITH_PASSWORD_MANAGER_VALUE
